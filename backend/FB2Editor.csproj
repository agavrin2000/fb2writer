<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Platforms>AnyCPU</Platforms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
    	<!-- Generate embedded file manifest when using the Photino.NET StaticFileServer -->
		<GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
		<ApplicationIcon>fb2writer.ico</ApplicationIcon>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<OutputType>Exe</OutputType>
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<Optimize>false</Optimize>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<OutputType>WinExe</OutputType>
		<DebuggerSupport>false</DebuggerSupport>
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<Optimize>true</Optimize>
		<SelfContained>true</SelfContained> <!-- Включает рантайм .NET внутрь EXE -->
		<EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>

		<!-- Запрещает копирование .pdb файлов зависимостей в выходную директорию -->
		<CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
		<PublishSingleFile>true</PublishSingleFile>
		<PublishTrimmed>true</PublishTrimmed>
		<TrimMode>partial</TrimMode>
		<PublishReadyToRun>false</PublishReadyToRun>

		<!-- Отключаем автоматическое включение файлов из папок проекта в финальную сборку -->
		<EnableDefaultContent>false</EnableDefaultContent>
    	<EnableDefaultContentItems>false</EnableDefaultContentItems>
		<IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>

		<EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
		<!--  Отключает внутреннюю систему логирования и трассировки событий .NET -->
		<EventSourceSupport>false</EventSourceSupport>
		<!--  Отключает расширенную поддержку метаданных моделей -->
		<IsEnhancedModelMetadataSupport>false</IsEnhancedModelMetadataSupport>
		<!-- Настройки для Windows -->
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<!-- Вырезает поддержку дескрипторов компонентов, которые не используются статически -->
		<EnableComponentRuntimeAnalyzer>false</EnableComponentRuntimeAnalyzer>
		<!-- Отключает функции отладки компонентов в рантайме -->
		<MicrosoftAspNetCoreComponentsWebOptions_EnableWebAssemblyDebugging>false</MicrosoftAspNetCoreComponentsWebOptions_EnableWebAssemblyDebugging>
		<!-- Отключает поддержку контроллеров и метаданных моделей (уберет большинство варнингов IL2026) -->
		<MetadataUpdaterSupport>false</MetadataUpdaterSupport>
		<!-- Отключает динамическую компиляцию выражений (часто используется в MVC) -->
		<EnableReflectionMetadata>false</EnableReflectionMetadata>
		<!-- Используется Photino.Server для раздачи папки wwwroot, поэтому
			можно принудительно обрезать зависимости Razor и контроллеров -->
		<AddRazorSupportForCompositeConfigurations>false</AddRazorSupportForCompositeConfigurations>
		<!-- Подавляем IL2104 (варнинги от сторонних сборок) и IL2026 (рефлексия в системных библиотеках) -->
		<NoWarn>$(NoWarn);IL2104;IL2026</NoWarn>
		<!-- Использовать для сетевых запросов родные механизмы операционной системы -->
		<UseNativeHttpHandler>true</UseNativeHttpHandler>
		<!-- Отключает анализ тримминга для всех внешних библиотек (NuGet), оставляя проверку только для вашего кода -->
		<SuppressTrimAnalysisWarnings>true</SuppressTrimAnalysisWarnings>
		<StackTraceSupport>false</StackTraceSupport>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Photino.NET" Version="4.0.16" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\wwwroot\**\*.*" />
    	<EmbeddedResource Include="Schemas\**\*.xsd" />
		<EmbeddedResource Include="fb2writer.ico" />
	</ItemGroup>
	
	<PropertyGroup>
		<FrontendRoot>..\frontend</FrontendRoot>
	</PropertyGroup>

	<!-- Запускаем билд только для Release-конфигурации -->
	<Target Name="BuildNextJs" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
		<Message Importance="high" Text="Собираем финальный билд фронтенда..." />
		
		<!-- 1. Сборка фронтенда -->
		<Exec WorkingDirectory="$(FrontendRoot)" Command="npm install" />
		<Exec WorkingDirectory="$(FrontendRoot)" Command="npm run build" />
		
		<!-- 2. Очистка старых файлов в целевой папке (опционально, но полезно) -->
		<RemoveDir Directories="Resources\wwwroot\" />

		<!-- 3. Копирование файлов из /out в /Resources/wwwroot -->
		<ItemGroup>
			<NextFiles Include="$(FrontendRoot)\out\**\*.*" />
		</ItemGroup>
		
		<Copy SourceFiles="@(NextFiles)" DestinationFolder="Resources\wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
	</Target> 

	<!-- Очистка от pdb-файлов -->
	<Target Name="CleanupNativePdb" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
		<Message Importance="high" Text="--- [CLEANUP] Удаление лишних символов отладки из $(PublishDir) ---" />
		<ItemGroup>
			<PdbToDelete Include="$(PublishDir)*.pdb" />
		</ItemGroup>
		
		<Delete Files="@(PdbToDelete)" />
	</Target>
</Project>
