<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<Platforms>AnyCPU</Platforms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
    	<!-- Generate embedded file manifest when using the Photino.NET StaticFileServer -->
		<GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.0.0-preview2" />
		<PackageReference Include="Avalonia.Desktop" Version="12.0.0-preview2" />
		<PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.4" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Photino.NET" Version="4.0.16" />
		<PackageReference Include="Photino.NET.Server" Version="4.0.12" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\**" />
	</ItemGroup>

	<PropertyGroup>
		<FrontendRoot>..\frontend</FrontendRoot>
	</PropertyGroup>

	<!-- Запускаем билд только для Release-конфигурации -->
	<Target Name="BuildNextJs" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
	<Message Importance="high" Text="Собираем финальный билд фронтенда..." />
	<Exec WorkingDirectory="$(FrontendRoot)" Command="npm install" />
	<Exec WorkingDirectory="$(FrontendRoot)" Command="npm run build" />
	
	<ItemGroup>
		<NextFiles Include="$(FrontendRoot)\out\**\*.*" />
	</ItemGroup>
	<Copy SourceFiles="@(NextFiles)" DestinationFolder="wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
	</Target>
</Project>
