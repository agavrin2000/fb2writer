<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Platforms>AnyCPU</Platforms>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
    	<!-- Generate embedded file manifest when using the Photino.NET StaticFileServer -->
		<GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Debug'">
		<OutputType>Exe</OutputType>
		<DebugType>portable</DebugType>
		<DebugSymbols>true</DebugSymbols>
		<Optimize>false</Optimize>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)' == 'Release'">
		<OutputType>WinExe</OutputType>
		<DebuggerSupport>false</DebuggerSupport>
		<EnableUnsafeBinaryFormatterSerialization>false</EnableUnsafeBinaryFormatterSerialization>
		<EventSourceSupport>false</EventSourceSupport>
		<PublishSingleFile>true</PublishSingleFile>
		<IncludeAllContentForSelfExtract>false</IncludeAllContentForSelfExtract>
		<EnableDefaultContent>false</EnableDefaultContent>
    	<EnableDefaultContentItems>false</EnableDefaultContentItems>
		<SelfContained>true</SelfContained> <!-- Включает рантайм .NET внутрь EXE -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier> <!-- Укажите нужную ОС: win-x64, linux-x4, osx-64 -->
		<!-- Настройки для Windows -->
		<IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<!-- Запрещает копирование .pdb файлов зависимостей в выходную директорию -->
		<CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
		<Optimize>true</Optimize>
	</PropertyGroup>
	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
		<PublishReadyToRun>true</PublishReadyToRun>
	</PropertyGroup>
	<!-- Настройки для Linux -->
	<PropertyGroup Condition="'$(RuntimeIdentifier)' == 'linux-x64'">
		<!-- На Linux ReadyToRun может требовать дополнительных настроек среды -->
		<PublishReadyToRun>false</PublishReadyToRun> 
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.0.0-preview2" />
		<PackageReference Include="Avalonia.Desktop" Version="12.0.0-preview2" />
		<PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" Version="10.0.4" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<PackageReference Include="Photino.NET" Version="4.0.16" />
		<PackageReference Include="Photino.NET.Server" Version="4.0.12" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\**" />
	</ItemGroup>
	<!--Маска **/*.xsd подхватит все файлы схем в папке Schemas и её подпапках 
	<ItemGroup>
	<None Update="Schemas\*.xsd">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
	</None>
	</ItemGroup>
	-->
	<ItemGroup>
	<None Include="Schemas\**\*.xsd">
		<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		<!-- Этот флаг заставит файл остаться в папке при SingleFile сборке -->
		<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
	</None>
	</ItemGroup>
	
	<PropertyGroup>
		<FrontendRoot>..\frontend</FrontendRoot>
	</PropertyGroup>

	<!-- Запускаем билд только для Release-конфигурации -->
	<Target Name="BuildNextJs" BeforeTargets="Build" Condition="'$(Configuration)' == 'Release'">
	<Message Importance="high" Text="Собираем финальный билд фронтенда..." />
	
	<!-- 1. Сборка фронтенда -->
	<Exec WorkingDirectory="$(FrontendRoot)" Command="npm install" />
	<Exec WorkingDirectory="$(FrontendRoot)" Command="npm run build" />
	
    <!-- 2. Очистка старых файлов в целевой папке (опционально, но полезно) -->
    <RemoveDir Directories="Resources\wwwroot\" />

    <!-- 3. Копирование файлов из /out в /Resources/wwwroot -->
    <ItemGroup>
        <NextFiles Include="$(FrontendRoot)\out\**\*.*" />
    </ItemGroup>
    
    <Copy 
        SourceFiles="@(NextFiles)" 
        DestinationFolder="Resources\wwwroot\%(RecursiveDir)" 
        SkipUnchangedFiles="true" 
    />

    <!-- 4. Важно для Photino: говорим .NET, что эти файлы являются контентом -->
    <ItemGroup>
        <Content Include="Resources\wwwroot\**\*.*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>
	</Target>

	<Target Name="CleanupNativePdb" AfterTargets="Publish" Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
        <PdbToDelete Include="$(PublishDir)*.pdb" />
    </ItemGroup>
    
    <Message Importance="high" Text="--- [CLEANUP] Удаление лишних символов отладки из $(PublishDir) ---" />
    <Delete Files="@(PdbToDelete)" />
</Target>
</Project>
